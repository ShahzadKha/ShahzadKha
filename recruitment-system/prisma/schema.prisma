// Recruitment System — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SDR
  RECRUITER
}

// Where a CV came from (diagram lane "Sources / Trigger")
enum CandidateSource {
  EMAIL // Email entrant (IMAP)
  WEB_FORM // Formulaire web (Skillhubs.io / landing page)
  CSV_IMPORT // Import CSV / API partenaires, jobboards
  FILE_DROP // Dépôt manuel CV (dossier surveillé)
  MANUAL // Ajout manuel par un recruteur
  REFERRAL // Recommandé par un client (étape 26)
}

// Pipeline statuses, in funnel order (diagram legend "Statuts du pipeline")
enum CandidateStatus {
  NEW_CV
  CV_PARSED
  GPT_ANALYZED
  NOT_ELIGIBLE
  PRODUCT_MATCHED
  EMAIL_1_SENT
  ENGAGED
  INTEREST_CONFIRMED
  OFFER_SENT
  PRICE_VIEWED
  PURCHASE_READY
  SDR_ASSIGNED
  CALL_COMPLETED
  WON
  LOST
  NURTURE
}

// Follow-up track chosen from the global score (diagram "Règles de routage")
enum RoutingTrack {
  EDUCATIONAL // < 50  — nurturing éducatif (pas de vente)
  LIGHT // 50–64 — nurturing léger
  CONVERSION // 65–79 — séquence de conversion
  CALL_INVITE // 80–89 — invitation à échanger
  PRIORITY_SDR // 90–100 — handoff SDR dès que les 4 conditions sont remplies
}

enum AnalysisState {
  PENDING
  DONE
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED // every email sent
  STOPPED // replied, unsubscribed, won/lost, or stopped by a person
}

enum SequenceKind {
  NURTURE // one per follow-up track, before the sale
  ONBOARDING // after payment: welcome, coaching, testimonial (steps 24–26)
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum EventType {
  CREATED
  UPDATED
  DUPLICATE_MERGED
  CV_PARSED
  AI_ANALYZED
  ANALYSIS_FAILED
  ROUTED
  STATUS_CHANGED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  PRICE_VIEWED
  UNSUBSCRIBED
  SEQUENCE_STARTED
  SEQUENCE_ENDED
  SDR_ASSIGNED
  CALL_LOGGED
  REFERRAL_CREATED
  MANUAL_EMAIL
  PAYMENT_LINK_SENT
  PAYMENT_CONFIRMED
  FEEDBACK_RECEIVED
  NOTE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECRUITER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Sessions opened before this moment are refused: changing a password logs out other devices
  passwordChangedAt DateTime?

  assignedCandidates Candidate[]      @relation("AssignedSdr")
  events             CandidateEvent[]
  tasks              CallTask[]
  notifications      Notification[]
}

// Products the company sells (trainings, certifications…)
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int // in euros
  keywords    String[] // skills / job titles that signal a good fit, used by the AI
  checkoutUrl String? // ThriveCart checkout link; empty = demo checkout page
  platformUrl String? // training platform link, sent in the welcome email
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  candidates Candidate[]
  payments   Payment[]
}

model Candidate {
  id           String          @id @default(cuid())
  firstName    String
  lastName     String
  email        String          @unique
  phone        String?
  phoneKey     String? // digits only, used to detect duplicates
  city         String?
  country      String?
  source       CandidateSource
  sourceDetail String? // partner, job board or campaign (e.g. "skillhubs", "indeed")
  status       CandidateStatus @default(NEW_CV)

  // Extracted from the CV
  currentTitle    String?
  yearsExperience Int?
  education       String?
  skills          String[]
  languages       String[]
  linkedinUrl     String?
  cvFileName      String?
  cvText          String?
  cvFile          CvFile?
  motivation      String? // message written by the candidate (web form)
  consentAt       DateTime? // GDPR consent given on the web form
  unsubscribedAt  DateTime? // clicked "unsubscribe": no more emails
  recycleCount    Int       @default(0) // times put back into a sequence after nurturing
  referredById    String? // the customer who recommended this person
  publicToken     String    @unique @default(uuid()) // for the candidate's offer and unsubscribe pages

  // AI analysis (step 6–8)
  persona       String?
  skillGap      String?
  aiSummary     String?
  fitScore      Int? // 0–100
  needScore     Int? // 0–100
  intentScore   Int? // 0–100
  globalScore   Int? // 0–100
  eligible      Boolean?
  routingTrack  RoutingTrack?
  analysisState AnalysisState?
  analysisMode  String? // "openai" or "demo"
  analysisModel String?
  analyzedAt    DateTime?
  analysisError String?

  recommendedProductId String?
  recommendedProduct   Product? @relation(fields: [recommendedProductId], references: [id])

  // Purchase-ready conditions (step 18)
  interestConfirmed Boolean @default(false)
  priceViewed       Boolean @default(false)
  timingDays        Int? // days until the candidate wants to start

  assignedSdrId String?
  assignedSdr   User?   @relation("AssignedSdr", fields: [assignedSdrId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events     CandidateEvent[]
  enrollment Enrollment?
  emails     EmailMessage[]
  tasks      CallTask[]
  payments   Payment[]
  feedback   Feedback?

  @@index([status])
  @@index([globalScore])
  @@index([phoneKey])
}

// One email sequence per follow-up track (diagram steps 10–17)
model EmailSequence {
  id          String        @id @default(cuid())
  kind        SequenceKind  @default(NURTURE)
  track       RoutingTrack? @unique // set for NURTURE sequences, empty for ONBOARDING
  name        String
  active      Boolean       @default(true)
  steps       EmailStep[]
  enrollments Enrollment[]
  updatedAt   DateTime      @updatedAt
}

model EmailStep {
  id         String         @id @default(cuid())
  sequenceId String
  sequence   EmailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int // 1, 2, 3…
  dayOffset  Int // days after the first email (0 = sent right away)
  subject    String
  body       String // plain text with {{variables}}
  isOffer    Boolean        @default(false) // contains the personalised offer link → status OFFER_SENT
  messages   EmailMessage[]

  @@unique([sequenceId, order])
}

// A candidate following a sequence
model Enrollment {
  id          String           @id @default(cuid())
  candidateId String           @unique
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sequenceId  String
  sequence    EmailSequence    @relation(fields: [sequenceId], references: [id])
  status      EnrollmentStatus @default(ACTIVE)
  stepsSent   Int              @default(0)
  startedAt   DateTime         @default(now())
  nextSendAt  DateTime?
  endedAt     DateTime?
  endReason   String?

  @@index([status, nextSendAt])
}

// Every email sent to a candidate, with tracking
model EmailMessage {
  id          String     @id @default(cuid())
  token       String     @unique @default(uuid()) // used in tracking links
  candidateId String
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stepId      String?
  step        EmailStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  kind        String     @default("sequence") // "sequence" or "offer"
  toEmail     String
  subject     String
  body        String
  provider    String // "simulated" or "smtp"
  sentAt      DateTime   @default(now())
  openedAt    DateTime?
  clickedAt   DateTime?
  repliedAt   DateTime?
  error       String?

  @@index([candidateId, sentAt])
}

// Step 19–21: a call an SDR has to make
model CallTask {
  id          String     @id @default(cuid())
  candidateId String
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sdrId       String
  sdr         User       @relation(fields: [sdrId], references: [id])
  kind        String     @default("closing") // "closing" or "callback"
  status      TaskStatus @default(OPEN)
  dueAt       DateTime
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  outcome     String? // payment_link, callback, nurture, lost
  notes       String?

  @@index([sdrId, status, dueAt])
}

// Step 23: payment confirmed (ThriveCart webhook or demo checkout)
model Payment {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  amount      Int // euros
  currency    String    @default("EUR")
  provider    String // "thrivecart" or "simulated"
  externalId  String?   @unique // ThriveCart order id
  paidAt      DateTime  @default(now())
  raw         Json?
}

// Step 26: NPS, testimonial and referral
model Feedback {
  id             String    @id @default(cuid())
  candidateId    String    @unique
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  nps            Int // 0–10
  comment        String?
  publishConsent Boolean   @default(false)
  referralName   String?
  referralEmail  String?
  createdAt      DateTime  @default(now())
}

// In-app notifications (bell in the header)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Original CV file, stored in the database so the app runs anywhere (Vercel included)
model CvFile {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now())
}

// Timeline entry for a candidate: everything that happens is logged here
model CandidateEvent {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        EventType
  title       String
  detail      String?
  toStatus    CandidateStatus? // status the candidate moved to, if this event changed it
  actorId     String?
  actor       User?            @relation(fields: [actorId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([candidateId, createdAt])
}

// Key/value settings (brand name, thresholds…) so the app is white-label
model Setting {
  key   String @id
  value Json
}

// Failed / successful logins, used to block password guessing
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Emails read from the inbox (IMAP): CVs sent by email and candidate replies
model InboundEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  fromEmail   String
  subject     String?
  receivedAt  DateTime
  processedAt DateTime @default(now())
  kind        String // "cv", "reply", "ignored", "error"
  detail      String?
  candidateId String?

  @@index([processedAt])
}

// "Mot de passe oublié": one-time link sent by email, valid 1 hour
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of the token; the token itself is only in the email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One use of a public form by one visitor (see src/lib/rate-limit.ts)
model RateHit {
  id        String   @id @default(cuid())
  key       String // "apply:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
