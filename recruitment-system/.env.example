# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitment?schema=public"

# Secret used to sign login sessions — use a long random string (32+ characters)
AUTH_SECRET="replace-with-a-long-random-string-of-32-characters"

# OpenAI (optional). Without a key the app runs in demo mode with rule-based analysis.
OPENAI_API_KEY=""
# Model used for CV analysis (default: gpt-5-mini)
OPENAI_MODEL=""

# Key for the intake API (POST /api/intake). Leave empty to disable the API.
INTAKE_API_KEY=""

# Public address of the app, used in email links (e.g. https://recruitment-demo.vercel.app)
APP_URL="http://localhost:3000"

# The team's time zone, used for every date shown and typed in the app (servers run in UTC)
APP_TIMEZONE="Europe/Paris"

# Real email sending (optional). Without SMTP_URL, emails are simulated: saved and shown in the app only.
# Example: smtp://user:password@smtp.provider.com:587
SMTP_URL=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# Protects the daily scheduler endpoint (/api/cron/sequences). Vercel Cron sends it automatically.
CRON_SECRET=""

# ThriveCart (optional). Same value as the webhook secret in ThriveCart → Settings → Integrations → Webhooks.
# Webhook URL to enter in ThriveCart: https://your-app/api/webhooks/thrivecart
THRIVECART_SECRET=""

# Inbox reading (optional): CVs received by email and candidate replies (IMAP)
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"

# Acumbamail contact sync (optional, step 10)
ACUMBAMAIL_AUTH_TOKEN=""
ACUMBAMAIL_LIST_ID=""

# Neon / hosted databases: the direct (non-pooled) connection string, used for migrations only
DIRECT_URL=""

# Show the demo accounts on the login page (local demos only — keep it off on a public site)
SHOW_DEMO_LOGINS="true"
